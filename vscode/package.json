{
  "name": "pi-pair",
  "displayName": "Pair for Pi",
  "description": "Review exact Pi proposals and approve steps inside your project in VS Code.",
  "version": "0.9.0",
  "publisher": "local-pair",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.cjs",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Review is available; approving or denying steps requires a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "11.12.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pair",
          "title": "Pair",
          "icon": "media/pair.svg"
        }
      ]
    },
    "views": {
      "pair": [
        {
          "id": "pair.review",
          "name": "Step",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "pair.review",
        "title": "Open Review",
        "category": "Pair",
        "icon": "$(open-preview)"
      },
      {
        "command": "pair.approve",
        "title": "Approve Entire Step",
        "category": "Pair",
        "icon": "$(check)",
        "enablement": "pair.canApprove"
      },
      {
        "command": "pair.deny",
        "title": "Deny Step",
        "category": "Pair",
        "icon": "$(close)",
        "enablement": "pair.canDecide"
      },
      {
        "command": "pair.denyWithNote",
        "title": "Deny with Note",
        "category": "Pair",
        "icon": "$(comment)",
        "enablement": "pair.canDecide"
      },
      {
        "command": "pair.openChange",
        "title": "Open Step Action",
        "category": "Pair"
      },
      {
        "command": "pair.nextFile",
        "title": "Next Action in Step",
        "category": "Pair",
        "icon": "$(arrow-down)"
      },
      {
        "command": "pair.previousFile",
        "title": "Previous Action in Step",
        "category": "Pair",
        "icon": "$(arrow-up)"
      },
      {
        "command": "pair.selectSession",
        "title": "Select Pi Session",
        "category": "Pair",
        "icon": "$(plug)"
      },
      {
        "command": "pair.refresh",
        "title": "Refresh Connection",
        "category": "Pair",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pair.selectSession",
          "when": "view == pair.review",
          "group": "navigation@1"
        },
        {
          "command": "pair.refresh",
          "when": "view == pair.review",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "pair.review",
          "when": "resourceScheme == pair-review",
          "group": "navigation"
        },
        {
          "command": "pair.previousFile",
          "when": "resourceScheme == pair-review",
          "group": "navigation"
        },
        {
          "command": "pair.nextFile",
          "when": "resourceScheme == pair-review",
          "group": "navigation"
        },
        {
          "command": "pair.approve",
          "when": "resourceScheme == pair-review && pair.canApprove",
          "group": "navigation"
        },
        {
          "command": "pair.denyWithNote",
          "when": "resourceScheme == pair-review && pair.canDecide",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Pair",
      "properties": {
        "pair.openReviewAutomatically": {
          "type": "boolean",
          "default": true,
          "description": "Open the Pair review and first diff when a new pending proposal arrives in this workspace."
        }
      }
    }
  }
}
