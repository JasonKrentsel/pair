{
  "name": "pi-pair",
  "version": "0.7.1",
  "private": true,
  "description": "Collaborative design and incremental implementation for Pi",
  "type": "module",
  "keywords": ["pi-package"],
  "scripts": {
    "test": "node --import ./scripts/pi-runtime.mjs --test tests/*.test.ts",
    "test:vscode": "node --test vscode/tests/*.test.cjs",
    "package:vscode": "powershell -NoProfile -File scripts/package-vscode.ps1",
    "preview": "node --import ./scripts/pi-runtime.mjs scripts/preview.ts",
    "capture": "node --import ./scripts/pi-runtime.mjs scripts/capture-fixtures.ts"
  },
  "pi": {
    "extensions": ["./extensions/pair/index.ts"],
    "skills": ["./skills"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "typebox": "^1.3.27"
  },
  "dependencies": {
    "diff": "^8.0.4"
  },
  "engines": { "node": ">=22.19.0" }
}
